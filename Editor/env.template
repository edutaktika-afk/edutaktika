# Polotno API Key Configuration Template
# Copy this file to .env and add your actual key value
# 
# For local development:
# 1. Create a file named ".env" in the Editor directory
# 2. Copy the content below into .env
# 3. Replace the values with your actual keys
#
# For Netlify production:
# Set the environment variables in Netlify Dashboard
#
# IMPORTANT: 
# - Do NOT include the pipe character "|" in the value
# - Do NOT commit the .env file (it's already in .gitignore)
# - The pipe character is added by Polotno SDK internally
# - No spaces around the equals sign

VITE_POLOTNO_API_KEY=KZiuYryOVcs9sz8q8A1l

# Cloudflare R2 Storage Configuration
# Your R2 Account ID (from Cloudflare dashboard)
VITE_R2_ACCOUNT_ID=87001b07874e84e7839c624361f60a3d

# Your R2 Access Key ID (from R2 API Tokens)
# Get this from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
VITE_R2_ACCESS_KEY_ID=your_access_key_id_here

# Your R2 Secret Access Key (from R2 API Tokens)
# Get this from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
VITE_R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Your R2 Bucket Name
VITE_R2_BUCKET_NAME=lessonflarer2

# Public URL for accessing files (your R2 public domain)
# This is the public development URL for your R2 bucket
VITE_R2_PUBLIC_URL=https://pub-5debe0c02d2d436787b8bc5adc76b013.r2.dev

# Optional: Supabase credentials (if using Supabase for metadata)
# Uncomment and fill in if needed:
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

